# Local database
LOCAL_DB_URL=jdbc:mysql://localhost:3306/lte_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
LOCAL_DB_USERNAME=your_db_username
LOCAL_DB_PASSWORD=your_db_password

# External APIs
YOUTUBE_API_KEY=your_youtube_api_key
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=your_kakao_client_secret
KAKAO_REDIRECT_URI=http://localhost:3000/login/oauth2/code/kakao

# JWT
JWT_SECRET=replace_with_a_utf8_secret_of_at_least_32_bytes
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=1209600000
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax

# AWS S3
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_access_key
AWS_REGION=ap-northeast-2
AWS_BUCKET=your_s3_bucket_name
